read_verilog fixtures/compare_prior.v
hierarchy -check -top dut
proc
flatten
opt
design -save reference
synth -top dut -noabc -noalumacc
check -assert
write_json runs/04_prior_history_compare_prior_noalumacc/mapped.json
stat
ltp -noff
design -save mapped
design -reset
design -copy-from reference -as gold dut
design -copy-from mapped -as gate dut
miter -equiv -flatten gold gate miter
hierarchy -check -top miter
sat -verify -prove trigger 0 -show-inputs -show-outputs
