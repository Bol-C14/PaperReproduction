; Table I arithmetic families, fixed uniform-width modular Expr semantics.
; Rules omitted: MUXAR (unresolved selector/type semantics).
; Power of two covered explicitly for 2^1..2^7 (8-bit fixtures).
; Estrin's listed factoring is subsumed by distributivity, not a separate rule.
(ruleset algebra)
(ruleset constants)
(ruleset proposal)
(rewrite (Add a b) (Add b a) :ruleset algebra)
(rewrite (Mul a b) (Mul b a) :ruleset algebra)
(rewrite (Add a (Add b c)) (Add (Add a b) c) :ruleset algebra)
(rewrite (Add (Add a b) c) (Add a (Add b c)) :ruleset algebra)
(rewrite (Mul a (Mul b c)) (Mul (Mul a b) c) :ruleset algebra)
(rewrite (Mul (Mul a b) c) (Mul a (Mul b c)) :ruleset algebra)
(rewrite (Add (Mul a b) (Mul a c)) (Mul a (Add b c)) :ruleset algebra)
(rewrite (Add (Add a b) (Add c d)) (Add (Add a c) (Add b d)) :ruleset algebra)
(rewrite (Add (Num 0) a) a :ruleset constants)
(rewrite (Add a (Num 0)) a :ruleset constants)
(rewrite (Mul (Num 0) a) (Num 0) :ruleset constants)
(rewrite (Mul (Num 1) a) a :ruleset constants)
(rewrite (Mul (Num 2) a) (Shl a 1) :ruleset constants)
(rewrite (Mul (Num 4) a) (Shl a 2) :ruleset constants)
(rewrite (Mul (Num 8) a) (Shl a 3) :ruleset constants)
(rewrite (Mul (Num 16) a) (Shl a 4) :ruleset constants)
(rewrite (Mul (Num 32) a) (Shl a 5) :ruleset constants)
(rewrite (Mul (Num 64) a) (Shl a 6) :ruleset constants)
(rewrite (Mul (Num 128) a) (Shl a 7) :ruleset constants)
(rewrite (Mul (Num c) a) (Add (Shl (Mul (Num (/ c 2)) a) 1) a) :when ((> c 1) (= (% c 2) 1)) :ruleset constants)
(rewrite (Mul (Num c) a) (Mul (Num (/ c 2)) (Mul (Num 2) a)) :when ((> c 0) (= (% c 2) 0)) :ruleset constants)
(rewrite (Shl (Shl a c) 1) (Shl a (+ c 1)) :ruleset constants)
; Deterministic proposal replay drawn from Appendix A. Not fresh LLM output.
(rewrite (Add a a) (Shl a 1) :ruleset proposal)
(rewrite (Mul (Num 7) a) (Sub (Shl a 3) a) :ruleset proposal)
(rewrite (Mul (Num 31) a) (Sub (Shl a 5) a) :ruleset proposal)
(rewrite (Mul (Num 19) a) (Add (Shl a 4) (Add (Shl a 1) a)) :ruleset proposal)
(rewrite (Mul (Num 12) a) (Add (Shl a 3) (Shl a 2)) :ruleset proposal)
(rewrite (Mul (Num 41) a) (Add (Add (Shl a 5) (Shl a 3)) a) :ruleset proposal)
(rewrite (Mul (Num 21) a) (Add (Add (Shl a 4) (Shl a 2)) a) :ruleset proposal)
(rewrite (Add (Shl a c) (Shl b c)) (Shl (Add a b) c) :ruleset proposal)
