# Raw tool feedback preserves exact trailing whitespace.
fixme/results/**/*.log -whitespace
# Exact staging/reference input bytes preserve upstream whitespace.
fixme/results/**/*.v -whitespace
fixme/results/**/*.sv -whitespace
fixme/results/**/*.cpp -whitespace
fixme/results/**/*.txt -whitespace
# Unified source diffs intentionally retain whitespace in context lines.
fixme/results/**/*.diff -whitespace
fixme/evidence/*.diff -whitespace
fixme/evaluator_validity/**/*.log -text -diff
fixme/evaluator_validity/**/*.sv -text
fixme/evaluator_validity/**/*.cpp -text
fixme/evaluator_validity/**/*.diff -text
# Preserve captured upstream source and feedback byte-for-byte.
fixme/evaluator_validity/** -whitespace
