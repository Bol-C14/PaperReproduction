GATE ZERO 0 O=CONST0;
GATE ONE 0 O=CONST1;
GATE BUF 1 O=a;
PIN * NONINV 1 999 1 0 1 0
GATE INV 1 O=!a;
PIN * INV 1 999 1 0 1 0
GATE AND2 1 O=a*b;
PIN * NONINV 1 999 1 0 1 0
GATE NAND2 1 O=!(a*b);
PIN * INV 1 999 1 0 1 0
GATE OR2 1 O=a+b;
PIN * NONINV 1 999 1 0 1 0
GATE NOR2 1 O=!(a+b);
PIN * INV 1 999 1 0 1 0
