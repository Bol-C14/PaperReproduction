# Copy this file to .env and provide credentials for an OpenAI-compatible API.
# Never commit .env.

# A single endpoint may serve all three historical model aliases, or users may
# replace the aliases below with models available from their provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Historical paper configuration. Exact provider deployment revisions were not
# retained, so live reruns may differ even when these aliases are available.
ROLLOUT_MODEL=azure/anthropic/claude-opus-4-6
MUTATION_MODEL=azure/anthropic/claude-sonnet-4-5
ANALYZER_MODEL=azure/openai/gpt-5
JUDGE_MODEL=azure/openai/gpt-5

# Local, generated state. Relative paths are resolved from the repository root.
TRACE2SKILL_DATA_ROOT=data/cvdp-v1.1.0
TRACE2SKILL_RUN_ROOT=runs
CVDP_REPOS_CACHE=data/repos-cache
CVDP_TMPDIR=runs/tmp
CVDP_DOCKER_ROOT_MIN_FREE_GB=20
CVDP_TMPDIR_MIN_FREE_GB=20

# Disabled by default: a public run must never delete containers it did not
# create. Enable only on a dedicated machine whose cvdp_ah_* containers you own.
CVDP_CLEAN_STALE_CONTAINERS_ON_START=0

# Built by scripts/build_cvdp_image.sh unless overridden.
CVDP_OSS_SIM_IMAGE=trace2skill/cvdp-sim-cocotb-compat:latest
CVDP_OSS_PNR_IMAGE=trace2skill/cvdp-sim-cocotb-compat:latest

# Conservative defaults for a workstation. Paper configs used two concurrent
# rollouts inside one task-local optimizer and ran the eight tasks sequentially.
NUM_SAMPLES_IN_PARALLEL=2
ROLLOUT_TIMEOUT=21600
